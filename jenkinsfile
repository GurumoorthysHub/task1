pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/GurumoorthysHub/task1.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'python -m pip install --upgrade pip'
                bat 'pip install -r requirements.txt || echo No dependencies to install'
            }
        }

        stage('Run App') {
            steps {
                bat 'python app.py'
            }
        }
    }

    post {
        always {
            echo 'Pipeline finished!'
        }
    }
}
